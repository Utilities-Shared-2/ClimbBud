# Voice-command settings for the voice Pi (the one with the microphone).
# Copy this file to .env in this folder and edit it:   cp .env.example .env
# Values set in the real environment (export / systemd) override this file.
#
# How it works:
#   Saying "start recording" / "end recording" publishes START / STOP to the
#   MQTT topic climbbud/control/session on the broker below. The telemetry
#   worker (health stats) and the dashboard (video + pose recording) are
#   subscribed to that topic, so they start/stop together when you speak.

# Address of the MQTT broker (the machine running mosquitto).
# This MUST be the same broker the telemetry worker and dashboard use
# (their MQTT_BROKER_IP). 127.0.0.1 only works if the broker runs on this Pi;
# otherwise use the broker machine's LAN or Tailscale IP, e.g. 192.168.50.10.
MQTT_BROKER_IP=127.0.0.1

# Broker port (mosquitto's default is 1883).
MQTT_BROKER_PORT=1883

# 1 = also save the microphone audio to voice-commands/recordings/rec_<time>.wav
#     while a session is active. 0 = only send the start/stop commands.
VOICE_RECORD_AUDIO=0
