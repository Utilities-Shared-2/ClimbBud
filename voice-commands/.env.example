# Voice-command settings for the voice Pi (the one with the microphone).
# Copy this file to .env in this folder and edit it:   cp .env.example .env
# Values set in the real environment (export / systemd) override this file.
#
# How it works — each phrase sends two requests:
#   "start recording":  POST <POSE_TRACKER_URL>/toggle?state=on
#                       POST <DASHBOARD_URL>/api/recording/start
#   "end recording":    POST <DASHBOARD_URL>/api/recording/stop
#                       POST <POSE_TRACKER_URL>/toggle?state=off
#   The dashboard starts/stops the video + pose recording and the health-stats
#   (telemetry) session, the same as clicking its Record button. The QNX pose
#   tracker turns tracking (pose model + servos) on/off.
#
# Both URLs need the http:// prefix.
#
# Test it without a mic:   python simulate_command.py start   (then: stop)

# Where the dashboard (ui/app.py) runs: http://<dashboard-machine-ip>:5000
# 127.0.0.1 only works if the dashboard runs on this Pi; otherwise use the
# dashboard machine's LAN or Tailscale IP, e.g. http://192.168.50.10:5000
DASHBOARD_URL=http://127.0.0.1:5000

# Where the QNX pose tracker runs (pose-landmarks/start.sh, port 8080):
# http://<qnx-ip>:8080. Leave empty to not control tracking from voice.
POSE_TRACKER_URL=http://192.168.50.2:8080

# Optional shared secret. If the dashboard sets RECORDING_API_TOKEN, put the
# same value here (sent as the X-ClimbBud-Token header). Leave empty if unused.
RECORDING_API_TOKEN=

# 1 = also save the microphone audio to voice-commands/recordings/rec_<time>.wav
#     while a session is active. 0 = only send the start/stop commands.
VOICE_RECORD_AUDIO=0
